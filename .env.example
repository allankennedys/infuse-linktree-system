# URL pública base codificada nos QR Codes. Depois de imprimir, NÃO pode mudar.
# Use exatamente o host final, sem barra no fim (ex.: https://qr.seudominio.com).
# Em produção precisa ser https.
APP_BASE_URL=

# Postgres. Em serverless use a connection string do pooler do provedor.
DATABASE_URL=
# Conexões por instância (opcional, padrão 3).
DATABASE_POOL_MAX=

# Segredo aleatório (mín. 32 caracteres) usado para anonimizar IPs no rate limiting.
# Gere com: openssl rand -base64 48
SESSION_SECRET=

# Opcional: restringe os destinos a estes hosts (separados por vírgula; aceita *.dominio.com).
# Vazio = qualquer host HTTPS, sempre configurado por admin autenticado.
DESTINATION_ALLOWED_HOSTS=

# Segredo do job de retenção (/api/cron/retencao). A Vercel envia como Bearer.
CRON_SECRET=

# Retenção em dias (opcional). Padrões: acessos agregados 90, auditoria 730.
SCAN_RETENTION_DAYS=
AUDIT_RETENTION_DAYS=

# Apenas desenvolvimento: permite destino http://localhost. Ignorado em produção.
ALLOW_INSECURE_LOCAL_DESTINATIONS=
